<html lang="en">
<%- include('./partials/head.ejs') %>
<body>
    <%- include('./partials/nav.ejs') %>
    <h1>Create new post</h1>

    <div class='mycontainer'>
        <form action='/posts' method='POST'>
            Title:
            <input type='text' name='title' id='title' required>
